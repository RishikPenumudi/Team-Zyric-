# SAHAJ AI Environment Configuration
# Smart Automated Heritage Artisan Natural Dyeing System

# Server Configuration
SAHAJ_HOST=0.0.0.0
SAHAJ_PORT=8000
SAHAJ_DEBUG=True

# Hardware Mode: "SIMULATION" (Default for demonstration) or "LIVE"
SAHAJ_HARDWARE_MODE=SIMULATION

# Google Gemini API Key
# Provide your Gemini API Key for live multimodal image understanding and assistant queries.
# If left blank, SAHAJ automatically uses its deterministic botanical heritage AI engine.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration
# Default uses local SQLite. Can be configured for PostgreSQL / Google Cloud AlloyDB Express.
DATABASE_URL=sqlite:///data/sahaj.db
